# brscan-scand configuration.
#
# Copy this file to ~/.config/brscan-scand.conf and edit it, or pass a path
# with `brscan-scand --config PATH`. Lines are `key = value`; blank lines and
# lines starting with `#` are ignored. Whitespace around the key and value is
# trimmed. An unrecognized key, or a value that doesn't parse, is ignored and
# leaves that setting at its default, so a partial config still starts the
# daemon.

# --- Required ---------------------------------------------------------------

# The printer's Bonjour hostname or IP address. Required: there is no default
# (every device's name is specific to that device), and the daemon refuses to
# start until you set it. Find yours with:
#   dns-sd -B _scanner._tcp
# which lists names like BRW00AABBCCDDEE; append `.local` for the hostname.
# Uncomment the next line and set it to your printer:
#printer_host = BRWxxxxxxxxxxxx.local

# --- General ----------------------------------------------------------------

# The name this Mac shows under in the printer's Scan menu. Defaults to this
# machine's host name. A `"` or `;` in the name is rejected at registration
# (the wire format has no way to escape them) and a generic fallback is used.
# display_name = Living Room Mac

# Where FILE-destination scans are saved. The directory is created if it
# doesn't exist. A leading ~ is expanded. Defaults to ~/Scans.
# save_dir = ~/Scans

# --- Per-destination scan settings ------------------------------------------
#
# Each of the four destinations (file, image, ocr, email) takes its own
# mode/dpi/source. Any you omit default to color, 300 dpi, flatbed.
#
#   <dest>.mode     color | gray | bw | errdiff | truegray
#   <dest>.dpi      a positive integer; sets both horizontal and vertical dpi
#   <dest>.source   flatbed | adf | adf-duplex

# file.mode = color
# file.dpi = 300
# file.source = flatbed

# image.mode = color
# image.dpi = 300

# ocr.mode = gray
# ocr.dpi = 300
# ocr.source = adf

# email.mode = gray
# email.dpi = 200

# --- Per-destination output format -------------------------------------------
#
# Each destination also takes its own output file format, mirroring
# iPrint&Scan Settings' "File Type" and "Document" (separation) choices:
#
#   <dest>.format             pdf | tiff | jpeg | png | native (default
#                             native: one file per page, in the format
#                             <dest>.mode implies -- JPEG for color, PGM for
#                             gray/truegray, PBM for bw/errdiff -- exactly
#                             today's behavior)
#   <dest>.tiff_compression   lzw | g3 | g4 (default lzw; only affects
#                             <dest>.format = tiff; g3/g4 are 1-bit fax
#                             codecs and only apply to a bilevel (bw/errdiff)
#                             page -- a color/gray page requested with g3/g4
#                             falls back to lzw instead of thresholding)
#   <dest>.separation         combine | off | image:N | page:N (N a positive
#                             integer; default combine -- one PDF/TIFF file
#                             for every page. image:N starts a new file every
#                             N single-sided images; page:N starts a new file
#                             every N pages -- named "..-doc001.pdf",
#                             "..-doc002.pdf", etc. either way. `every:N` is
#                             also accepted, as a backward-compat alias for
#                             `image:N`. Only applies to pdf/tiff -- the
#                             per-page formats (jpeg/png/native) always write
#                             one file per page regardless. Note: image:N and
#                             page:N currently behave identically -- for a
#                             duplex scan, whether the vendor's "page count"
#                             groups two sides of one sheet into one document
#                             is not yet confirmed; see daemon/config.cpp's
#                             ParseSeparationString comment.)
#
# OCR is special: it does not use <dest>.format at all. Its output is
# chosen by the dedicated ocr.ocr_format key below (and, when the printer's
# LCD Touch Panel is ON, by the panel's own sub-format setting).

# file.format = pdf
# file.separation = every:1

# image.format = jpeg

# email.format = pdf
# email.tiff_compression = g4

# --- OCR output sub-format ----------------------------------------------------
#
# The OCR destination writes a searchable PDF by default, but the printer's
# LCD OCR settings screen also offers plain-text, HTML, and RTF. This key
# selects the OCR output when the scan-button press did NOT carry its own
# sub-format -- i.e. with the LCD Touch Panel OFF ("from computer" / Auto).
# When Touch Panel is ON, the panel's own T= sub-format wins and this key is
# ignored (same ON/OFF precedence as the other per-destination settings).
#
#   ocr.ocr_format   pdf | txt | html | rtf (default pdf)
#
# pdf writes a searchable PDF (the image with a Vision-recognized invisible
# text layer). txt/html/rtf instead write just the recognized text as a
# .txt/.html/.rtf file -- no image, no searchable layer.

# ocr.ocr_format = pdf

# --- Per-destination paper size ----------------------------------------------
#
# Sets an explicit paper size per destination, for use when the printer's LCD
# panel Touch Panel setting is OFF (in which case the panel doesn't send its
# own paper choice with the button press). Not yet consulted by the daemon --
# only stored and parsed as of this writing -- so setting it has no effect
# yet. Accepted tokens (Brother's own paper names, case-sensitive):
#
#   <dest>.paper   LETTER | LEGAL | A4 | LEDGER | A3 | A5 | EXECUTIVE |
#                  PHOTO | BCARD (default empty -- no explicit paper)

# file.paper = LETTER

# --- Per-destination remove-background ---------------------------------------
#
# Sets the "from computer" (Touch Panel OFF / Auto) scan's remove-background
# level per destination -- the OFF-path counterpart of the LCD panel's own
# remove-background setting, which stays authoritative whenever Touch Panel
# is ON (this key has no effect on that path).
#
#   <dest>.remove_background   off | low | medium | high (default off)

# image.remove_background = medium

# --- Destination action settings --------------------------------------------

# IMAGE destination: the app that opens the saved scan, as `open -a <app>`.
# Leave unset to open in the file's default app for its type.
# image_app = Preview

# EMAIL destination: the address the composed message is pre-addressed to.
# Leave unset to leave the To: field blank. The message is opened for you to
# review and is never sent automatically.
# email_to = someone@example.com
